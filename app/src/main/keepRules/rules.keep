# Keep rules for R8, which shrinks the release build. AGP passes every file in src/main/keepRules
# to R8, together with the libraries' own rules.
# See https://d.android.com/r/tools/r8/keep-rules

# Readium's reader runs JavaScript in a WebView, which calls back into methods marked with
# @JavascriptInterface. R8 can't see those calls, so the methods are kept.
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}
